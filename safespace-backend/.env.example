# ── Brevo SMTP Configuration ──
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-brevo-smtp-login
SPRING_MAIL_PASSWORD=your-brevo-smtp-key

# ── Mail Sender Settings ──
MAIL_FROM_ADDRESS=your-verified-email@domain.com
MAIL_FROM_NAME=SafeSpace System
APP_URL=http://localhost:5173
MAIL_ENABLED=true

# ── Database (Optional Override) ──
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/safespace
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=secret
