# ── Brevo REST API Configuration ──
BREVO_API_KEY=your-brevo-api-key-xkeysib

# ── Mail Sender Settings ──
MAIL_FROM_ADDRESS=your-verified-email@domain.com
MAIL_FROM_NAME=SafeSpace System
APP_URL=http://localhost:5173
MAIL_ENABLED=true

# ── Database (Neon Cloud PostgreSQL / Local Override) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your-neon-password

